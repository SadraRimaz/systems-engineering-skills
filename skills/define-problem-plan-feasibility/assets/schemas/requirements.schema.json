{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stakeholder Requirements",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REQ-\\d{3}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "phase_id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "performance",
              "constraint"
            ]
          },
          "threshold": {
            "type": [
              "string",
              "number",
              "null"
            ]
          },
          "goal": {
            "type": [
              "string",
              "number",
              "null"
            ]
          },
          "unit": {
            "type": "string"
          },
          "conditions": {
            "type": "string"
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "object",
            "properties": {
              "stakeholder_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "scenario_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "interface_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "objective_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "mission_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "qualification_method": {
            "enum": [
              "demonstration",
              "analysis_simulation",
              "inspection",
              "instrumented_test"
            ]
          },
          "tbd": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "proposed",
              "agreed"
            ]
          }
        },
        "required": [
          "id",
          "statement",
          "phase_id",
          "category",
          "kind",
          "rationale",
          "sources",
          "status"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "partition_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "phase_id": {
            "type": "string",
            "minLength": 1
          },
          "group": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "n/a"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "phase_id",
          "group",
          "status",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "open_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ISS-\\d{3}$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "TBD",
              "TBR",
              "question"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "open",
              "closed"
            ]
          },
          "about": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "text",
          "kind",
          "owner",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "decisions_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^DEC-\\d{3}$"
          },
          "date": {
            "type": "string"
          },
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "date",
          "decision",
          "rationale"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "meta",
    "requirements",
    "partition_notes",
    "open_issues",
    "decisions_log"
  ],
  "additionalProperties": false
}
