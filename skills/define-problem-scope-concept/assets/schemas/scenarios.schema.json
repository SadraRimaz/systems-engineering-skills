{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operational Scenarios",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object"
    },
    "mission_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^MSN-\\d{3}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "measure": {
            "type": "string",
            "minLength": 1
          },
          "stakeholder_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "statement",
          "measure",
          "stakeholder_ids"
        ],
        "additionalProperties": false
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SCN-\\d{3}$"
          },
          "phase_id": {
            "type": "string",
            "minLength": 1
          },
          "stakeholder_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "environment_conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "user_story": {
            "type": "object",
            "properties": {
              "as_a": {
                "type": "string",
                "minLength": 1
              },
              "i_want": {
                "type": "string",
                "minLength": 1
              },
              "so_that": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "as_a",
              "i_want",
              "so_that"
            ],
            "additionalProperties": false
          },
          "exchanges": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "minLength": 1
                },
                "to": {
                  "type": "string",
                  "minLength": 1
                },
                "item": {
                  "type": "string",
                  "minLength": 1
                },
                "item_kind": {
                  "enum": [
                    "data",
                    "energy",
                    "matter"
                  ]
                },
                "note": {
                  "type": "string"
                }
              },
              "required": [
                "from",
                "to",
                "item",
                "item_kind"
              ],
              "additionalProperties": false
            },
            "minItems": 2
          },
          "variations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "phase_id",
          "stakeholder_ids",
          "kind",
          "title",
          "goal",
          "user_story",
          "exchanges"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "coverage_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "phase_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "n/a"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "phase_id",
          "kind",
          "status",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "open_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ISS-\\d{3}$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "TBD",
              "TBR",
              "question"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "open",
              "closed"
            ]
          },
          "about": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "text",
          "kind",
          "owner",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "decisions_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^DEC-\\d{3}$"
          },
          "date": {
            "type": "string"
          },
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "date",
          "decision",
          "rationale"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "meta",
    "mission_requirements",
    "scenarios",
    "coverage_notes",
    "open_issues",
    "decisions_log"
  ],
  "additionalProperties": false
}
