{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Objectives Hierarchy",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object"
    },
    "hierarchies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^OBJ-H\\d+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "scope_phase_id": {
            "type": "string"
          },
          "stakeholder_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^OBJ-\\d{3}$"
          },
          "hierarchy_id": {
            "type": "string",
            "minLength": 1
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "enum": [
              "fundamental",
              "value",
              "measure"
            ]
          },
          "design_independent": {
            "type": "boolean"
          },
          "measure_kind": {
            "enum": [
              "effectiveness",
              "performance"
            ]
          },
          "unit": {
            "type": "string"
          },
          "direction": {
            "enum": [
              "increase",
              "decrease"
            ]
          },
          "threshold": {
            "type": "number"
          },
          "goal": {
            "type": "number"
          },
          "weight": {
            "type": "number"
          },
          "value_curve": {
            "type": "object",
            "properties": {
              "shape": {
                "enum": [
                  "linear",
                  "concave",
                  "convex",
                  "s_curve",
                  "piecewise"
                ]
              },
              "points": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            },
            "required": [
              "shape"
            ],
            "additionalProperties": false
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "stakeholder_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "scenario_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rationale": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "hierarchy_id",
          "parent_id",
          "name",
          "level",
          "design_independent"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "open_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ISS-\\d{3}$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "TBD",
              "TBR",
              "question"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "open",
              "closed"
            ]
          },
          "about": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "text",
          "kind",
          "owner",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "decisions_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^DEC-\\d{3}$"
          },
          "date": {
            "type": "string"
          },
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "date",
          "decision",
          "rationale"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "meta",
    "hierarchies",
    "nodes",
    "open_issues",
    "decisions_log"
  ],
  "additionalProperties": false
}
